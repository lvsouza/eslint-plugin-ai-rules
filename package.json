{
  "name": "eslint-plugin-ai-rules",
  "version": "2.0.0",
  "description": "Flat-config ESLint plugin that enforces filenames, imports and project structure for AI-generated code.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "yarn clean",
    "build": "tsup",
    "dev": "tsup --watch",
    "prelint": "yarn build",
    "lint": "eslint .",
    "lint:check": "yarn build && eslint .",
    "typecheck": "tsc --noEmit",
    "test": "yarn build && node --test test/*.test.mjs",
    "test:watch": "node --test --watch test/*.test.mjs",
    "test:coverage": "yarn build && c8 --include dist/index.js --check-coverage --lines 95 --branches 90 --functions 95 --reporter=text node --test test/*.test.mjs",
    "test:consumer": "node scripts/TestConsumer.mjs",
    "test:package": "yarn build && publint --pack npm && attw --pack .",
    "verify:build": "node scripts/CheckBuildArtifacts.mjs",
    "test:release": "yarn verify && yarn test:coverage && yarn test:consumer && yarn test:package",
    "verify": "yarn typecheck && yarn test && yarn lint && npm pack --dry-run",
    "prepack": "yarn build"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "flat-config",
    "ai-rules",
    "project-structure",
    "architecture",
    "boundaries"
  ],
  "author": "Lucas Souza <ls18017@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvsouza/eslint-ai-guard.git"
  },
  "homepage": "https://github.com/lvsouza/eslint-ai-guard#readme",
  "bugs": {
    "url": "https://github.com/lvsouza/eslint-ai-guard/issues"
  },
  "peerDependencies": {
    "eslint": "^9.22.0 || ^10.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "typescript": ">=5.0.0 <6.1.0"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.0.0",
    "eslint-plugin-boundaries": "^7.4.1",
    "eslint-plugin-import-x": "^4.0.0",
    "typescript-eslint": "^8.72.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.6.6",
    "c8": "^12.0.0",
    "eslint": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "globals": "^17.0.0",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=1.22.0"
  },
  "packageManager": "yarn@1.22.22"
}
