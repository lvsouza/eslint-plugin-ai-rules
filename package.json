{
  "name": "eslint-plugin-ai-rules",
  "version": "0.3.1",
  "description": "ESLint plugin com regras úteis para projetos com ESLint - AI Rules",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "yarn clean",
    "build": "tsup",
    "dev": "tsup --watch",
    "prelint": "yarn build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "yarn build && node --test test/*.test.mjs",
    "test:coverage": "yarn build && c8 --include dist/index.js --check-coverage --lines 95 --branches 90 --functions 95 --reporter=text node --test test/*.test.mjs",
    "test:consumer": "node scripts/TestConsumer.mjs",
    "test:package": "npx --yes publint --pack npm && npx --yes @arethetypeswrong/cli --pack .",
    "test:release": "yarn test:consumer && yarn test:package",
    "verify": "yarn typecheck && yarn test && yarn lint && npm pack --dry-run",
    "prepack": "yarn build",
    "prepublishOnly": "test -z \"$(git status --porcelain)\" || (echo '✖ working tree not clean — commit before publishing' && exit 1) && yarn verify",
    "postpublish": "echo '✔ published. Run: git push --follow-tags'"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "ai-rules"
  ],
  "author": "Lucas Souza <ls18017@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvsouza/eslint-ai-guard.git"
  },
  "homepage": "https://github.com/lvsouza/eslint-ai-guard#readme",
  "bugs": {
    "url": "https://github.com/lvsouza/eslint-ai-guard/issues"
  },
  "peerDependencies": {
    "eslint": "^9.22.0 || ^10.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "typescript": ">=5.0.0 <6.1.0"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.0.0",
    "eslint-plugin-boundaries": "^7.4.1",
    "eslint-plugin-import-x": "^4.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "c8": "^12.0.0",
    "eslint": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "globals": "^17.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
